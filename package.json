{
  "name": "keyforge",
  "private": true,
  "version": "1.0.0",
  "description": "KeyForge — a private naming and identity toolkit: usernames, project names, team names, person names, personas and secure passwords.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
